POSTGRES_USER=alvo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alvo

APP_PORT=8080
PLATFORM=prod

JWT_SECRET=change-me-openssl-rand-base64-64

# Optional. The four development tickers (PETR4, VALE3, ITUB4, MGLU3) are
# tokenless on brapi's free tier, so this stays empty until Phase 12.
BRAPI_TOKEN=

# docker-compose.dev.yml only. Set POSTGRES_PORT to something else if the host
# already runs a Postgres on 5432 — the dev override publishes this port.
POSTGRES_PORT=5432
VITE_PORT=5173

# docker-compose.prod.yml only
ALVO_DOMAIN=
ALVO_TLS_EMAIL=

# goose CLI on the host. The app runs migrations itself on startup, so these are
# only for `goose up` / `goose status` / `goose down` by hand, and they need the
# dev override running (the base compose does not publish the db port).
# The host port here must match POSTGRES_PORT above.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://alvo:change-me@localhost:5432/alvo?sslmode=disable
GOOSE_MIGRATION_DIR=sql/schema
