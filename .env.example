POSTGRES_USER=alvo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alvo

APP_PORT=8080
PLATFORM=prod

JWT_SECRET=change-me-openssl-rand-base64-64

# Optional. The four development tickers (PETR4, VALE3, ITUB4, MGLU3) are
# tokenless on brapi's free tier, so this stays empty until Phase 12.
BRAPI_TOKEN=

# In-process candle scheduler. Off by default so a dev box never starts calling
# brapi on its own; turn it on wherever the deployment is meant to stay current.
# INGEST_INTRADAY=false drops the 5m pass and leaves daily running, which is the
# Free-tier shape: daily keeps updating, 5m freezes at the last backfill.
# INGEST_FILL_AT is the wall-clock time in the exchange timezone for the day's single
# fill. The B3 close is 17:00 but brapi keeps revising the closing candle after it, so
# the pass waits until the evening. It never fires before the close.
# INGEST_FUTURES adds a daily pass over the futures term structure: one request per root,
# and a no-op until `sync-futures` has actually backfilled something.
INGEST_ENABLED=false
INGEST_INTRADAY=true
INGEST_FUTURES=true
INGEST_FILL_AT=20:00

# docker-compose.dev.yml only. Set POSTGRES_PORT to something else if the host
# already runs a Postgres on 5432 — the dev override publishes this port.
POSTGRES_PORT=5432
VITE_PORT=5173

# docker-compose.prod.yml only. The prod override also sets TRUST_PROXY=true,
# which is what makes per-IP rate limiting key on the real client rather than on
# Caddy's address. Leave it false anywhere the app is reached directly: with no
# proxy in front, X-Forwarded-For is whatever the caller chose to send.
ALVO_DOMAIN=
ALVO_TLS_EMAIL=

# goose CLI on the host. The app runs migrations itself on startup, so these are
# only for `goose up` / `goose status` / `goose down` by hand, and they need the
# dev override running (the base compose does not publish the db port).
# The host port here must match POSTGRES_PORT above.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://alvo:change-me@localhost:5432/alvo?sslmode=disable
GOOSE_MIGRATION_DIR=sql/schema
